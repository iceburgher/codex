# Supabase — sätts i Vercel under Project Settings → Environment Variables.
# Båda måste vara satta för att projekten ska sparas i molnet. Saknas de
# sparar appen bara i webbläsaren.
#
# Nyckeln är hemlig och läses enbart på servern. Lägg den aldrig i en
# NEXT_PUBLIC_-variabel och committa den aldrig.
SUPABASE_URL=https://ditt-projekt.supabase.co
SUPABASE_SECRET_KEY=
